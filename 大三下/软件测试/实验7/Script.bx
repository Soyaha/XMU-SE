														<content>&lt;!DOCTYPE html&gt;
&lt;html lang=&quot;zh-CN&quot;&gt;
&lt;head&gt;
    &lt;meta charset=&quot;UTF-8&quot;&gt;
    &lt;title&gt;Title&lt;/title&gt;


    &lt;link rel=&quot;stylesheet&quot; href=&quot;/layui/css/layui.css&quot;&gt;
    &lt;style&gt;

        body {
            /*width: 100%;*/
            /*height: 100%;*/
            background: url(&quot;/images/background.png&quot;) no-repeat;
            /*background: url(&quot;static/images/a.png&quot;) no-repeat;*/
            background-size: cover;
        }

        #login_form {
            width: 400px;
            height: 400px;
            margin: 80px auto;
            padding: 30px;
            background-color: #f2f2f2;
            opacity: 0.9;
        }

    &lt;/style&gt;
&lt;/head&gt;
&lt;body&gt;

&lt;div id=&quot;wrapper&quot;&gt;
    &lt;div class=&quot;layui-container&quot; id=&quot;login_form&quot;&gt;

        &lt;div&gt;
            &lt;h1 style=&quot;color: red&quot;&gt;鍥句功绠＄悊绯荤粺&lt;/h1&gt;
            &lt;br&gt;
            &lt;h2&gt;鐢ㄦ埛鐧诲綍&lt;/h2&gt;
            &lt;br&gt;
        &lt;/div&gt;

        &lt;form class=&quot;layui-form&quot; id=&quot;my_form&quot; method=&quot;post&quot; action=&quot;/userLogin&quot;&gt;

            &lt;div class=&quot;layui-form-item&quot;&gt;
                &lt;label class=&quot;layui-form-label&quot;&gt;鐢ㄦ埛鍚?&lt;/label&gt;
                &lt;div class=&quot;layui-input-block&quot;&gt;
                    &lt;input type=&quot;text&quot; name=&quot;userName&quot; id=&quot;username&quot; autofocus
                           placeholder=&quot;璇疯緭鍏ョ敤鎴峰悕&quot; autocomplete=&quot;off&quot; class=&quot;layui-input&quot;&gt;
                &lt;/div&gt;
            &lt;/div&gt;

            &lt;div class=&quot;layui-form-item&quot;&gt;
                &lt;label class=&quot;layui-form-label&quot;&gt;瀵?鐮?&lt;/label&gt;
                &lt;div class=&quot;layui-input-block&quot;&gt;
                    &lt;input type=&quot;password&quot; name=&quot;password&quot; id=&quot;password&quot;
                           placeholder=&quot;璇疯緭鍏ュ瘑鐮? autocomplete=&quot;off&quot; class=&quot;layui-input&quot;&gt;
                &lt;/div&gt;
            &lt;/div&gt;


            &lt;div class=&quot;layui-form-item&quot;&gt;
                &lt;label class=&quot;layui-form-label&quot;&gt;鐢ㄦ埛韬唤&lt;/label&gt;
                &lt;div class=&quot;layui-input-block&quot;&gt;
                    &lt;input class=&quot;form-check-input&quot; type=&quot;radio&quot; name=&quot;role&quot; value=&quot;1&quot; title=&quot;瀛︾敓&quot; checked&gt;
                    &lt;input class=&quot;form-check-input&quot; type=&quot;radio&quot; name=&quot;role&quot; value=&quot;0&quot; title=&quot;绠＄悊鍛?&gt;
                &lt;/div&gt;
            &lt;/div&gt;

            &lt;div class=&quot;layui-form-item layui-col-md4 layui-col-md-offset4&quot;&gt;
                &lt;button id=&quot;sub_btn&quot; class=&quot;layui-btn layui-btn-normal&quot;&gt;鐧诲綍&lt;/button&gt;
            &lt;/div&gt;

        &lt;/form&gt;

    &lt;/div&gt;
&lt;/div&gt;


&lt;script src=&quot;/scripts/jquery.min.js&quot;&gt;&lt;/script&gt;
&lt;script src=&quot;/layui/layui.js&quot;&gt;&lt;/script&gt;


&lt;script&gt;
    layui.use([&apos;layer&apos;, &apos;form&apos;], function () {
        let layer = layui.layer;
        let form = layui.form;
        form.render();

        $(function () {
            let flag = null;
            if (flag) {
                layer.msg(&quot;鐢ㄦ埛鍚嶆垨瀵嗙爜閿欒&quot;, {
                    icon: 2,
                    time: 2000 //2绉掑叧闂紙濡傛灉涓嶉厤缃紝榛樿鏄?绉掞級
                });
            }
        });
    });


    $(&quot;#sub_btn&quot;).click(function () {
        let username = $(&quot;#username&quot;).val();
        let user_judge = check(username);

        // 棣栧厛鍒ゆ柇鐢ㄦ埛鍚嶆槸鍚︿负绌?
        if (user_judge) {
            let password = $(&quot;#password&quot;).val();
            let pwd_judge = check(password);

            // 鐢ㄦ埛鍚嶄笉涓虹┖  , 鍒ゆ柇瀵嗙爜鏄惁涓虹┖
            if (pwd_judge) {
                let role_id = $(&apos;input[name=&quot;role&quot;]:checked&apos;).val();

                // 濡傛灉role_id ==1 ,鍒欐槸鏅€氱敤鎴?, 鐩存帴鎻愪氦琛ㄥ崟
                if (role_id == 1) {
                    $(&quot;#my_form&quot;).submit();
                } else {

                    //濡傛灉鏄鐞嗗憳 , 鍒欏皢action 杩涜鏇存敼 
                    $(&quot;#my_form&quot;).attr(&quot;action&quot;, &quot;/adminLogin&quot;)
                    $(&quot;#my_form&quot;).submit();
                }

            } else {
                layer.alert(&quot;瀵嗙爜涓嶈兘涓虹┖&quot;, {icon: 5});
                return false;
            }
        } else {

            layer.alert(&quot;鐢ㄦ埛鍚嶄笉鑳戒负绌?, {icon: 5});
            return false;
        }
    });

    // 鏍￠獙琛ㄥ崟涓敤鎴峰悕 涓?瀵嗙爜鏄惁杈撳叆,  濡傛灉鏈夊€?-&gt; 杩斿洖 true , 濡傛灉鏈緭鍏?杩斿洖 false;
    function check(val) {
        val = val.toString().trim();
        return !(val == &apos;&apos;);
    }

&lt;/script&gt;
&lt;/body&gt;
&lt;/html&gt;</content>
